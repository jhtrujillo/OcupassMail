Options -Indexes

# Bloquear respaldos, bases de datos, docs y archivos ocultos en la raíz
<FilesMatch "(\.(tar|gz|zip|sqlite|sqlite-wal|sqlite-shm|db|md|lock|log|bak|sql)$|^\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>
